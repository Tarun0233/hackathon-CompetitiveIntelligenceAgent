# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Hindsight Cloud key: https://ui.hindsight.vectorize.io -> Billing (apply MEMHACK99) -> Create API Key.
# Shown ONCE - paste it here immediately. Do not restrict it to specific banks.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Base name for the memory banks. Actual banks used are <this>-cold, <this>-early, <this>-full.
HINDSIGHT_BANK_ID=competitive-intel-demo

# Groq: https://groq.com/ (free tier). Used for the agent's own reasoning only,
# not for Hindsight's internal fact extraction.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
